# OpenRouter API Key for AI analysis
OPENROUTER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Chat Webhook URLs
GOOGLE_CHAT_WEBHOOK_URL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMPLOYEE_ALERT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_EMPLOYEE_SPACE/messages?key=YOUR_KEY&token=YOUR_TOKEN

# Spreadsheet ID for timesheet links in employee reminders
SPREADSHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Site info for OpenRouter rankings
SITE_URL=https://your-site.com
SITE_NAME=Task Verifier

# Test Mode - Set to 'true' to disable all notifications (for testing)
TEST_MODE=true
